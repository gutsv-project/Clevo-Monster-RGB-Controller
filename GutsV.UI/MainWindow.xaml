<Window x:Class="GutsV.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GutsV.UI.ViewModels"
        mc:Ignorable="d"
        Title="GutsV Colour" Height="720" Width="900" MinHeight="600"
        Icon="pack://application:,,,/icon.png"
        Background="#000000"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        WindowStyle="None" AllowsTransparency="True">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <ResourceDictionary Source="Styles.xaml"/>
    </Window.Resources>

    <Border BorderThickness="1" BorderBrush="#333" CornerRadius="10" Background="#0F0F0F">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" MouseLeftButtonDown="DragWindow" Background="Transparent">
                <TextBlock Text="GUTSV" FontSize="20" FontWeight="Bold" Foreground="#00D4FF" 
                           HorizontalAlignment="Left" Margin="20,15">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#00D4FF" BlurRadius="10" ShadowDepth="0"/>
                    </TextBlock.Effect>
                </TextBlock>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                    <!-- Cleanup Button -->
                    <Button Width="30" Height="30" Click="CleanClick" 
                            Background="Transparent" BorderThickness="0" Margin="0,0,10,0" ToolTip="Reset and Remove Service Mode">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Background="Transparent">
                                    <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" 
                                          Fill="#888" Stretch="Uniform" Margin="7">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                        <Setter Property="Fill" Value="#FF4444"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Content="_" Width="30" Height="30" Click="MinimizeClick" 
                            Background="Transparent" Foreground="#888" BorderThickness="0" FontSize="16"/>
                    <Button Content="[ ]" Width="30" Height="30" Click="MaximizeClick" 
                            Background="Transparent" Foreground="#888" BorderThickness="0" FontSize="14"/>
                    <Button Content="X" Width="30" Height="30" Click="CloseClick" 
                            Background="Transparent" Foreground="#FF4444" BorderThickness="0" FontWeight="Bold"/>
                </StackPanel>
            </Grid>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="258"/> <!-- Sidebar (250 + scrollbar gutter) -->
                    <ColumnDefinition Width="*"/>   <!-- Preview Area -->
                </Grid.ColumnDefinitions>

                <!-- Left Panel: Controls (scrolls when the window is shorter than its content) -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                <StackPanel>
                     <!-- Status Badge -->
                    <Border Background="#1A1A1A" CornerRadius="8" Padding="10" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="STATUS" FontSize="10" Foreground="#555" FontWeight="Bold"/>
                            <DockPanel Margin="0,5,0,0">
                                <Ellipse Width="8" Height="8" Margin="0,4,8,0" VerticalAlignment="Top" DockPanel.Dock="Left">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#FF4444"/> <!-- Red (Not Ready) -->
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                    <Setter Property="Fill" Value="#00FF88"/> <!-- Green (Ready) -->
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#CCC" TextWrapping="Wrap"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Driver Override -->
                    <ComboBox SelectedIndex="{Binding DriverType}" Margin="0,0,0,20" Background="#222" Foreground="#CCC">
                        <ComboBoxItem Content="Auto Detect"/>
                        <ComboBoxItem Content="Insyde / Acer (1-4 Zone)"/>
                        <ComboBoxItem Content="WMI (3-Zone)"/>
                    </ComboBox>

                    <!-- BRIGHTNESS SLIDER -->
                    <TextBlock Text="BRIGHTNESS" Foreground="#888" FontSize="11" Margin="0,5,0,5" FontWeight="SemiBold"/>
                    <Grid Height="30" Margin="0,0,0,15">
                        <Slider Minimum="0" Maximum="100" Value="{Binding Brightness}" 
                                IsSnapToTickEnabled="True" TickFrequency="5" 
                                VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Brightness, StringFormat={}{0}%}" 
                                   Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Right" 
                                   Margin="0,-25,0,0" FontSize="11"/>
                    </Grid>

                    <!-- COLOR MIXER (Sliding RGB) -->
                    <TextBlock Text="COLOR MIXER" FontSize="12" Foreground="#888" Margin="0,0,0,10"/>
                    
                    <!-- Zone Selector: tick one or more zones, then APPLY (only on multi-zone keyboards) -->
                    <StackPanel Margin="0,0,0,15">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMultiZoneCapable}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <DockPanel Margin="0,0,0,6">
                            <Button Content="NONE" Command="{Binding SelectNoZonesCommand}" DockPanel.Dock="Right"
                                    Style="{StaticResource SmallNeonButtonStyle}" Margin="6,0,0,0"/>
                            <Button Content="ALL" Command="{Binding SelectAllZonesCommand}" DockPanel.Dock="Right"
                                    Style="{StaticResource SmallNeonButtonStyle}"/>
                            <TextBlock Text="ZONES" Foreground="#888" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding ZoneItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding DisplayName}" Tag="{Binding DisplayBrush}"
                                              Style="{StaticResource ZoneChipStyle}" Margin="0,0,6,6"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding SelectedZonesText}" Foreground="#666" FontSize="10" TextTrimming="CharacterEllipsis" Margin="2,0,0,0"/>
                    </StackPanel>

                    <DockPanel Margin="0,5">
                        <TextBlock Text="R" Width="20" Foreground="#FF4444" VerticalAlignment="Center"/>
                        <Slider Maximum="255" Value="{Binding Red}"/>
                    </DockPanel>
                    <DockPanel Margin="0,5">
                        <TextBlock Text="G" Width="20" Foreground="#00FF88" VerticalAlignment="Center"/>
                        <Slider Maximum="255" Value="{Binding Green}"/>
                    </DockPanel>
                    <DockPanel Margin="0,5">
                        <TextBlock Text="B" Width="20" Foreground="#00D4FF" VerticalAlignment="Center"/>
                        <Slider Maximum="255" Value="{Binding Blue}"/>
                    </DockPanel>

                    <!-- Hex Input -->
                    <DockPanel Margin="0,15,0,0">
                        <TextBlock Text="#" Width="20" Foreground="#888" VerticalAlignment="Center" FontWeight="Bold"/>
                        <TextBox Text="{Binding HexColor, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" CharacterCasing="Upper"/>
                    </DockPanel>

                    <!-- RGB Values (Editable) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <TextBlock Text="R:" Foreground="#FF4444" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding Red, UpdateSourceTrigger=PropertyChanged}" Width="30" Margin="3,0,10,0" MaxLength="3" FontSize="10" Padding="2" HorizontalContentAlignment="Center"/>
                        
                        <TextBlock Text="G:" Foreground="#00FF88" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding Green, UpdateSourceTrigger=PropertyChanged}" Width="30" Margin="3,0,10,0" MaxLength="3" FontSize="10" Padding="2" HorizontalContentAlignment="Center"/>
                        
                        <TextBlock Text="B:" Foreground="#00D4FF" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding Blue, UpdateSourceTrigger=PropertyChanged}" Width="30" Margin="3,0,0,0" MaxLength="3" FontSize="10" Padding="2" HorizontalContentAlignment="Center"/>
                    </StackPanel>

                    <Button Content="APPLY EFFECT" Command="{Binding ApplyColorCommand}" IsDefault="True"
                            Style="{StaticResource NeonButtonStyle}" Height="40" Margin="0,20,0,0"/>

                    <!-- HARDWARE (firmware) effects & brightness: only for keyboards that report support -->
                    <StackPanel Margin="0,20,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHardwareEffectsSupported}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="HARDWARE EFFECTS" Foreground="#888" FontSize="11" Margin="0,0,0,5" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding HardwareEffects}" SelectedItem="{Binding SelectedHardwareEffect}"
                                  Margin="0,0,0,10" Background="#222" Foreground="#CCC"/>
                        <Button Content="APPLY HARDWARE EFFECT" Command="{Binding ApplyHardwareEffectCommand}"
                                Style="{StaticResource NeonButtonStyle}" Height="34"/>
                        <TextBlock Text="HARDWARE BRIGHTNESS (0-4)" Foreground="#888" FontSize="11" Margin="0,15,0,5" FontWeight="SemiBold"/>
                        <Slider Minimum="0" Maximum="4" Value="{Binding HardwareBrightness}"
                                IsSnapToTickEnabled="True" TickFrequency="1" TickPlacement="BottomRight"/>
                    </StackPanel>

                    <!-- OVERRIDE BOOT EFFECT (only if the firmware reports support) -->
                    <CheckBox Content="Override Boot Effect" IsChecked="{Binding BootEffectEnabled}" Margin="0,20,0,0">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBootEffectSupported}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>

                    <!-- KEYBOARD SLEEP TIMER (only if the firmware reports support) -->
                    <StackPanel Margin="0,15,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSleepTimerSupported}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <CheckBox Content="Keyboard Sleep Timer" IsChecked="{Binding SleepTimerEnabled}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" IsEnabled="{Binding SleepTimerEnabled}">
                            <TextBox Text="{Binding SleepTimerHours, UpdateSourceTrigger=LostFocus}" Width="36" MaxLength="1" HorizontalContentAlignment="Center"/>
                            <TextBlock Text="h" Foreground="#888" Margin="4,0,10,0" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding SleepTimerMinutes, UpdateSourceTrigger=LostFocus}" Width="36" MaxLength="2" HorizontalContentAlignment="Center"/>
                            <TextBlock Text="m" Foreground="#888" Margin="4,0,10,0" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding SleepTimerSecondsPart, UpdateSourceTrigger=LostFocus}" Width="36" MaxLength="2" HorizontalContentAlignment="Center"/>
                            <TextBlock Text="s" Foreground="#888" Margin="4,0,10,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="APPLY SLEEP TIMER" Command="{Binding ApplySleepTimerCommand}" IsEnabled="{Binding SleepTimerEnabled}"
                                Style="{StaticResource NeonButtonStyle}" Height="34" Margin="0,8,0,0"/>
                        <TextBlock Text="5 s – 1 h 59 m 59 s" Foreground="#666" FontSize="10" Margin="0,4,0,0"/>
                    </StackPanel>

                </StackPanel>
                </ScrollViewer>

                 <!-- Right Panel: Visualization & Effects -->
                <Grid Grid.Column="1" Margin="20,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>    <!-- Keyboard Visual (Flexible) -->
                        <RowDefinition Height="Auto"/> <!-- Effects Selector -->
                    </Grid.RowDefinitions>

                    <!-- Keyboard Outline (Scalable with Viewbox) -->
                     <Viewbox Grid.Row="0" Margin="0,0,0,10">
                        <Border BorderThickness="2" CornerRadius="15" Width="600" Height="250" Background="#050505">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{Binding PreviewColor}"/>
                            </Border.BorderBrush>
                            <Border.Effect>
                                <DropShadowEffect Color="{Binding PreviewColor}" BlurRadius="40" ShadowDepth="0" Opacity="0.5"/>
                            </Border.Effect>
                            
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Watermark behind the keys -->
                                <TextBlock Grid.RowSpan="2" Text="GUTS V" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="60" FontWeight="Black" Opacity="0.05" Foreground="White" IsHitTestVisible="False"/>

                                <!-- Keyboard picture split into the detected zones. Each block: name on top, keys in the zone color.
                                     Selected zones: cyan name + outline. -->
                                <ItemsControl ItemsSource="{Binding KeyboardSections}" Margin="15,12,15,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Width="{Binding PreviewWidth}" Margin="2,0">
                                                <TextBlock DockPanel.Dock="Top" Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" Margin="0,0,0,4">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#666"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Foreground" Value="#00D4FF"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Border CornerRadius="6" Padding="2" BorderThickness="1.5">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="#1F1F1F"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="#00D4FF"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <ItemsControl ItemsSource="{Binding Keys}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid Rows="5" Columns="{Binding KeyColumns}"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Style="{StaticResource KeyStyle}" Opacity="0.85" Height="28"
                                                                        Background="{Binding DataContext.DisplayBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Light Bar / Logo LED: glowing indicators in their own color -->
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding ExtraZones}" HorizontalAlignment="Center" Margin="0,2,0,10">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="14,0">
                                                <Border Width="44" Height="8" CornerRadius="4" Background="{Binding DisplayBrush}" VerticalAlignment="Center">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="{Binding DisplayColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.9"/>
                                                    </Border.Effect>
                                                </Border>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#666"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Foreground" Value="#00D4FF"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Viewbox>

                    <!-- Animation Models -->
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="ANIMATION MODES" FontSize="12" Foreground="#888" Margin="0,0,0,10"/>
                        
                        <ListBox ItemsSource="{Binding Animations}" SelectedItem="{Binding SelectedAnimation}" 
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" IsItemsHost="True" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="2"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder" Background="#222" BorderBrush="#444" BorderThickness="1" 
                                                        CornerRadius="5" Margin="2" Padding="10,15" Cursor="Hand">
                                                    <TextBlock x:Name="ItemText" Text="{Binding Name}" Foreground="#CCC" FontWeight="Bold" 
                                                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>    
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#00D4FF"/>
                                                        <Setter TargetName="ItemBorder" Property="Effect">
                                                             <Setter.Value>
                                                                 <DropShadowEffect Color="#00D4FF" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
                                                             </Setter.Value>
                                                        </Setter>
                                                        <Setter TargetName="ItemText" Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#00D4FF"/>
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#00D4FF"/>
                                                        <Setter TargetName="ItemText" Property="Foreground" Value="Black"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <!-- Animation Speed Control (Visible only when running) -->
                        <Grid Margin="0,15,0,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAnimationRunning}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            
                            <StackPanel>
                                <TextBlock Text="ANIMATION SPEED" FontSize="11" Foreground="#888" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                <Grid Height="30">
                                    <Slider Minimum="0.2" Maximum="3.0" Value="{Binding AnimationSpeed}" 
                                            IsSnapToTickEnabled="True" TickFrequency="0.1" 
                                            VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding AnimationSpeed, StringFormat={}{0:F1}x}" 
                                               Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Right" 
                                               Margin="0,-25,0,0" FontSize="11"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Start/Stop Button -->
                        <Button Command="{Binding ToggleAnimationCommand}" Height="45" Margin="0,10,0,0" Cursor="Hand">
                             <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NeonButtonStyle}">
                                    <Setter Property="Content" Value="START ANIMATION ▶"/>
                                    <Setter Property="Foreground" Value="#00D4FF"/>
                                    <Setter Property="BorderBrush" Value="#00D4FF"/>
                                    <Style.Triggers>
                                        <!-- Running State: Red Stop Button -->
                                        <DataTrigger Binding="{Binding IsAnimationRunning}" Value="True">
                                            <Setter Property="Content" Value="STOP ANIMATION ⏹"/>
                                            <Setter Property="Foreground" Value="#FF4444"/>
                                            <Setter Property="BorderBrush" Value="#FF4444"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                             </Button.Style>
                        </Button>

                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="15,10">
                <!-- Telegram Link -->
                <Button HorizontalAlignment="Left" Click="OpenTelegramClick" Cursor="Hand" Background="Transparent" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-2.05-1.35-1.74-2.18.25-1.51 2.76-3.8 3.51-4.8.19-.25-.43-.46-.86-.18-2.43 1.57-4.8 3.33-4.82 3.39-.4.24-.95.42-1.55.23L4.4 11.23c-.6-.2-.61-.61.13-.91l6.93-2.69c3.24-1.22 3.86-1.51 4.18-1.43z" 
                                      Fill="#00D4FF" Height="20" Width="20" Stretch="Uniform" Margin="0,0,8,0">
                                    <Path.Effect>
                                        <DropShadowEffect Color="#00D4FF" BlurRadius="5" ShadowDepth="0"/>
                                    </Path.Effect>
                                </Path>
                                <TextBlock Text="acerhizm" VerticalAlignment="Center" Foreground="#888" FontSize="12" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                    <Setter Property="Foreground" Value="#00D4FF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <TextBlock Text="v1.0.0" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#444"/>
            </Grid>
        </Grid>
    </Border>
</Window>
